<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WanderLust</title>
  </head>
  <body>
    <h3>Create a New Listing</h3>
    <form action="/listings" method="POST">
      <div>
        <label for="title" class="form-label">Title</label>
        <input
          type="text"
          name="title"
          value=""
          placeholder="Enter Title"
          class="form-control"
        />
      </div>
      <div mb="3">
        <label for="description" class="form-control">Description</label>
        <textarea
          name="listing[description]"
          placeholder="Enter Description"
        ></textarea>
      </div>
      <div mb="3">
        <label for="price" class="form-control">Price</label>
        <input type="number" name="price" placeholder="Enter Price" class="form-control" />
      </div>
      <div mb="3">
        <label for="location" class="form-control">Location</label>
        <input
          type="text"
          name="location"
          placeholder="Enter Location"
          class=""
        />
      </div>
      <div class="mb-3">
        <label for="image" class="form-control">Image Link</label>
        <input
          type="text"
          name="image"
          placeholder="Enter Image URL"
          class="form-control"
        />
      </div>
      <div class="mb-3">
        <label for="country" class="form-control">Country</label>
        <input
          type="text"
          name="country"
          placeholder="Enter Country"
          class="form-control"
        />
      </div>
      <br><br>
      <button type="submit" class="btn-btn-dark">Create Listing</button>
    </form>
  </body>
</html>
