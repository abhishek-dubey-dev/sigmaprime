<% layout("/layouts/boilerplate") %>

<div class="row mt-4 justify-content-center">
  <div class="col-12 col-lg-9 show-card">
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="alert alert-success" role="alert">
        <%= successMessage %>
      </div>
    <% } %>

    <div class="show-page-header">
      <h3 class="mb-0"><%= foundListing.title %></h3>
    </div>

    <div class="card show-listing-card">
      <img
        src="<%= foundListing.image.url || foundListing.image %>"
        class="card-img-top show-image"
        alt="<%= foundListing.title %>"
      />

      <div class="card-body show-card-body">
        <h4 class="card-title mb-3"><%= foundListing.title %></h4>

        <div class="show-meta">
          <p class="mb-2">
            <strong>Price:</strong> &#8377;<%= foundListing.price.toLocaleString("en-IN") %>
          </p>
          <p class="mb-2">
            <strong>Location:</strong> <%= foundListing.location %>
          </p>
          <p class="mb-2">
            <strong>Country:</strong> <%= foundListing.country %>
          </p>
          <p class="mb-0">
            <strong>Description:</strong> <%= foundListing.description %>
          </p>
        </div>
      </div>
    </div>

    <div class="mt-3 d-flex flex-wrap gap-2">
      <a href="/listings/<%= foundListing._id %>/edit" class="btn btn-dark">Edit</a>

      <form action="/listings/<%= foundListing._id %>?_method=DELETE" method="POST" class="d-inline">
        <button type="submit" class="btn btn-danger">Delete</button>
      </form>
    </div>

    <hr />

    <div class="mt-3 review-panel">
      <h4>Leave a Review</h4>

      <form action="/listings/<%= foundListing._id %>/reviews" method="POST" noValidate class="needs-validation review-form">
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating:</label>
          <input type="range" class="form-control" id="rating" name="review[rating]" min="1" max="5" required>
        </div>
        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comment:</label>
          <textarea class="form-control" id="comment" name="review[comment]" cols="30" rows="3" required></textarea>
          <div class="invalid-feedback">Please enter a valid comment.</div>
        </div>
        <button type="submit" class="btn btn-outline-dark">Submit Review</button>
      </form>

      <p class="mt-4"><b>All Reviews</b></p>
      <div class="row g-3">

        <% for (let review of foundListing.reviews) { %>
        <div class="card col-12 review-item">
          <div class="card-body">
            <h5 class="card-title"><strong>Reviewer:</strong> Guest</h5>
            <p class="card-text"><strong>Comment:</strong> <%= review.comment %></p>
            <p class="card-text"><strong>Rating:</strong> <%= review.rating %> stars</p>
          </div>
          <form class="mb-3 ms-3" method="POST" action="/listings/<%= foundListing._id %>/reviews/<%= review._id %>?_method=DELETE">
            <button class="btn btn-sm btn-dark">Delete</button>
          </form>
        </div>
        <% } %>

      </div>
    </div>
  </div>
</div>
