<% layout("layouts/boilerplate") %>
  <body>
    <h3>Listing Details :</h3>
    <ul>
      <li>Title: <%= foundListing.title %></li>
      <li>Description: <%= foundListing.description %></li>
      <li>Price: &#8377;<%= foundListing.price.toLocaleString("en-IN") %></li>
      <li>Location: <%= foundListing.location %></li>
      <li>Country: <%= foundListing.country %></li>
    </ul>
    <br />
    <a href="/listings/<%= foundListing._id %>/edit">Edit this Listing</a>

    <form
      action="/listings/<%= foundListing._id %>?_method=DELETE"
      method="POST"
    >
      <button type="submit">Delete this Listing</button>
    </form>
  </body>

