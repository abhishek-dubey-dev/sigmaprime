<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
</head>
<body>
    <h3>Edit Listing</h3>
    <form action="/listings/<%= foundListing._id %>?_method=PUT" method="POST">
        <input type="text" name="title" value="<%= foundListing.title %>" placeholder="Enter Title" />
        <input type="text" name="description" value="<%= foundListing.description %>" placeholder="Enter Description" />
        <input type="number" name="price" value="<%= foundListing.price %>" placeholder="Enter Price" />
        <input type="text" name="location" value="<%= foundListing.location %>" placeholder="Enter Location" />
        <input type="text" name="image" value="<%= foundListing.image %>" placeholder="Enter Image URL" />
        <input type="text" name="country" value="<%= foundListing.country %>" placeholder="Enter Country" />
        <br>
        <button type="submit">Update Listing</button>
    </form>
</body>
</html>