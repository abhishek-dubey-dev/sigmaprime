<% layout("/layouts/boilerplate") %>

<div class="mt-3 mb-3">
  <h1 class="mb-0">All Listings</h1>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-3 justify-content-center">
  <% for (let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card listing-card col" style="width: 19.5rem;">
        <img src="<%= listing.image.url || listing.image %>" class="card-img-top" alt="listing_image" />
        <div class="card-img-overlay"></div>
        <div class="card-body">
          <p class="card-text listing-card-text">
            <b class="listing-title"><%= listing.title %></b><br />
            &#8377;<%= listing.price.toLocaleString("en-IN") %> /night
          </p>
        </div>
      </div>
    </a>
  <% } %>
</div>

